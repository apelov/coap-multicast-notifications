   int no_replay = (flags & COAP_OSCORE_DECRYPT_NO_REPLAY) != 0;
+  oscore_replay_state_t replay_saved = { 0, 0, 0, 0 };
   coap_bin_const_t pdu_token;
   uint8_t *st_encrypt;
   size_t encrypt_len;
@@ -1251,6 +1285,8 @@
